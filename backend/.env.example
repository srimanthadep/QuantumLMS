# Copy to backend/.env for local development (git-ignored). In AWS these come from the task definition and Secrets
# Manager (see infra/).
NODE_ENV=development
PORT=4000
PUBLIC_API_URL=http://localhost:4000
# Browser origins allowed to call the API directly. Not needed when the web app reaches it through /api on the same origin.
CORS_ORIGINS=http://localhost:8443

# PostgreSQL. Supabase: Project settings > Database > Connection string > Session pooler (port 5432), or the
# transaction pooler (port 6543) when several API instances run: the API keeps no session state, so both work.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# require (TLS, no certificate check) | verify (TLS checked against DATABASE_CA_CERT) | disable
DATABASE_SSL=require
# DATABASE_CA_CERT=./prod-ca-2021.crt
# Connections per API process. Supabase's session pooler allows 15 clients in total on the smallest compute size, so
# keep (processes x this) under it: the dev server and the test run share it locally.
DATABASE_POOL_MAX=5

# Cognito. `npm run cognito:setup` fills these in (local emulator or your AWS account).
COGNITO_REGION=eu-north-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Local emulator only (npm run cognito:local). Leave empty for AWS.
COGNITO_ENDPOINT=http://localhost:9229

# Uploads: local disk in development, S3 in AWS.
STORAGE_DRIVER=local
UPLOAD_SIGNING_SECRET=<at least 16 random characters>
# STORAGE_DRIVER=s3
# S3_BUCKET=quantum-lms-uploads
# S3_REGION=eu-north-1

CAMPUS_TZ=Asia/Kolkata
DEMO_MODE=true
