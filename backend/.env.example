# Copy to backend/.env for local development (git-ignored). In AWS these come from the task definition and Secrets
# Manager (see infra/).
NODE_ENV=development
PORT=4000
PUBLIC_API_URL=http://localhost:4000
# Browser origins allowed to call the API directly. Not needed when the web app reaches it through /api on the same origin.
CORS_ORIGINS=http://localhost:8443

# PostgreSQL. Supabase: Project settings > Database > Connection string > Session pooler (port 5432), or the
# transaction pooler (port 6543) when several API instances run: the API keeps no session state, so both work.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# verify (system trust store or DATABASE_CA_CERT) | require/disable (development only)
DATABASE_SSL=verify
# DATABASE_CA_CERT=./prod-ca-2021.crt
# Connections per API process. Supabase's session pooler allows 15 clients in total on the smallest compute size, so
# keep (processes x this) under it: the dev server and the test run share it locally.
DATABASE_POOL_MAX=5

# Cognito. `npm run cognito:setup` fills these in (local emulator or your AWS account).
COGNITO_REGION=eu-north-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Local emulator only (npm run cognito:local). Leave empty for AWS.
COGNITO_ENDPOINT=http://localhost:9229

# Uploads: local disk in development, S3 in AWS.
STORAGE_DRIVER=local
UPLOAD_SIGNING_SECRET=<at least 16 random characters>
# STORAGE_DRIVER=s3
# S3_BUCKET=quantum-lms-uploads
# S3_REGION=eu-north-1

CAMPUS_TZ=Asia/Kolkata
DEMO_MODE=false

# Isolated tests only: npm test never loads this file or DATABASE_URL.
# Set PG_BIN in your shell if initdb/pg_ctl are not on PATH.
# PG_BIN=C:/Program Files/PostgreSQL/18/bin
# Alternatively set TEST_ADMIN_DATABASE_URL to a disposable loopback PostgreSQL server
# in CI. The runner creates a separate random database for each test file.

# Dedicated media worker (one job, two DB connections per worker).
MEDIA_MAX_UPLOAD_BYTES=5368709120
MEDIA_MAX_DURATION_SECONDS=28800
MEDIA_TEMP_BUDGET_BYTES=17179869184
MEDIA_JOB_TIMEOUT_SECONDS=21600
MEDIA_LEASE_SECONDS=120
MEDIA_POLL_SECONDS=5
MEDIA_PYTHON=python3
MEDIA_MODEL_PATH=/opt/models/whisper-small
MEDIA_FFMPEG=ffmpeg
MEDIA_FFPROBE=ffprobe
# Docker/infra build setting: a reviewed full commit SHA from Systran/faster-whisper-small.
WHISPER_MODEL_REVISION=536b0662742c02347bc0e980a01041f333bce120

# Optional Razorpay TEST MODE only. Leave unset to keep paid checkout unavailable.
# Use a different webhook secret from the API key secret. Never commit real credentials.
# RAZORPAY_KEY_ID=rzp_test_your_key
# RAZORPAY_KEY_SECRET=your_test_secret
# RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
PAYMENT_RESERVATION_MINUTES=15
PAYMENT_SWEEP_SECONDS=30
PAYMENT_HTTP_TIMEOUT_MS=15000

# Durable future session generation. Set 0 only for isolated tests.
SCHEDULE_SWEEP_SECONDS=60

# Local one-click sessions only; requires NODE_ENV=development and DEMO_MODE=true. Never enable in AWS.
DEV_FAKE_LOGIN=false
DEMO_TEACHER_EMAIL=shanmuk@lms.com
