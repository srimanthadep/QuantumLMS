FROM node:24.11.1-bookworm-slim AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY tsconfig*.json ./
COPY src ./src
RUN npm run build && npm prune --omit=dev

FROM python:3.12.9-slim-bookworm
COPY --from=mwader/static-ffmpeg:9.0.2-1 /ffmpeg /ffprobe /usr/local/bin/
COPY --from=build /usr/local/bin/node /usr/local/bin/node
WORKDIR /app
COPY worker/requirements.txt /app/worker/requirements.txt
RUN pip install --no-cache-dir -r worker/requirements.txt
# An explicit model revision is required: do not silently fetch a changing model at runtime.
ARG WHISPER_MODEL_REVISION=536b0662742c02347bc0e980a01041f333bce120
RUN test -n "$WHISPER_MODEL_REVISION" && python -c "from huggingface_hub import snapshot_download; snapshot_download('Systran/faster-whisper-small', revision='$WHISPER_MODEL_REVISION', local_dir='/opt/models/whisper-small')"
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=build /app/package.json ./package.json
COPY worker ./worker
RUN useradd --system --uid 10001 worker
USER worker
ENV NODE_ENV=production MEDIA_MODEL_PATH=/opt/models/whisper-small
CMD ["node", "dist/media/worker.js"]
