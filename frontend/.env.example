# Supabase project behind the student portal. Copy to .env.local (git-ignored), or generate it with
# `node backend/scripts/frontend-env.mjs`. The publishable key is browser-safe; row-level security protects the data.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<key>
