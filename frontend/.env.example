# Copy to .env.local (git-ignored). These values are public: they identify the Cognito app client, not a secret.

# Amazon Cognito user pool and app client for sign-in (`npm run cognito:setup` in backend/ prints them).
VITE_COGNITO_REGION=eu-north-1
VITE_COGNITO_USER_POOL_ID=eu-north-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Local development against the cognito-local emulator (`npm run cognito:local` in backend/). It only supports
# password sign-in, so leave both empty for a real user pool (the app then uses SRP).
# VITE_COGNITO_ENDPOINT=http://localhost:9229
# VITE_COGNITO_AUTH_FLOW=USER_PASSWORD_AUTH

# Optional: the API's origin when it isn't served on this site's /api (Vite proxies /api to localhost:4000 in
# development; CloudFront routes /api/* to the API in AWS).
# VITE_API_URL=https://api.example.com
